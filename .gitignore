# ============================================
# AIDesk Project - Global .gitignore
# ============================================
# This file ensures NO secrets or sensitive data are committed to Git

# ============================================
# ENVIRONMENT VARIABLES & SECRETS (CRITICAL)
# ============================================
# Root level
.env
.env.local
.env.production
.env.development
.env.test
.env.staging
.env.*
*.env

# Backend environment files
backend/.env
backend/.env.local
backend/.env.production
backend/.env.*
backend/*.env

# Frontend environment files
frontend/.env
frontend/.env.local
frontend/.env.production
frontend/.env.development
frontend/.env.*
frontend/*.env

# Any .env files anywhere in the project
**/.env
**/.env.local
**/.env.production
**/.env.*
**/*.env

# ============================================
# SENSITIVE DATA & STORAGE
# ============================================
# News storage (contains collected articles - SENSITIVE)
storage/news.json
storage/news-data/*.json
storage/news-data/**/*.json
backend/storage/news.json
backend/storage/news-data/*.json
backend/storage/news-data/**/*.json
# Allow .gitkeep files
!storage/news-data/.gitkeep
!backend/storage/news-data/.gitkeep

# User data (SENSITIVE)
storage/users/*.json
storage/users/**/*.json
backend/storage/users/*.json
backend/storage/users/**/*.json
# Allow .gitkeep files
!storage/users/.gitkeep
!backend/storage/users/.gitkeep

# ============================================
# DEPENDENCIES
# ============================================
# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Note: package-lock.json is usually committed, but uncomment if you don't want it
# package-lock.json
yarn.lock
pnpm-lock.yaml

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv
pip-log.txt
pip-delete-this-directory.txt
*.egg-info/
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json

# ============================================
# BUILD ARTIFACTS & CACHE
# ============================================
# Next.js
.next/
out/
build/
dist/
.vercel
.vercel/

# Python build
*.pyc
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/

# ============================================
# IDE & EDITOR FILES
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sublime-project
*.sublime-workspace

# ============================================
# LOGS & TEMPORARY FILES
# ============================================
*.log
logs/
*.tmp
*.temp
.cache/
*.bak
*.backup

# ============================================
# DATABASE FILES
# ============================================
*.db
*.sqlite
*.sqlite3
*.sql

# ============================================
# TESTING & COVERAGE
# ============================================
.coverage
coverage/
htmlcov/
*.cover
.pytest_cache/
.tox/

# ============================================
# OS SPECIFIC
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ============================================
# PROJECT SPECIFIC
# ============================================
# Jupyter Notebooks
.ipynb_checkpoints

# Celery
celerybeat-schedule
celerybeat.pid

# SageMath
*.sage.py

# Spyder
.spyderproject
.spyproject

# Rope
.ropeproject

# mkdocs
/site

# Pyre
.pyre/

# ============================================
# SECURITY: Additional patterns to catch secrets
# ============================================
# Common secret file patterns (be specific to avoid false positives)
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.jks
*.keystore

# Secret/config files (specific patterns)
*secret*.json
*secrets*.json
*secret*.env
*secrets*.env
*password*.json
*password*.env
*credential*.json
*credential*.env
*credentials*.json
*credentials*.env

# But allow certain files that might match
!package.json
!package-lock.json
!tsconfig.json
!next.config.ts
!next.config.js
